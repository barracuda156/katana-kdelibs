[Protocol]
exec=kio_curl
protocol=https
copyToFile=false
copyFromFile=false
listing=false
reading=true
writing=true
makedir=false
deleting=false
moving=false
Icon=text-html
maxInstances=20
maxInstancesPerHost=5
defaultMimetype=application/octet-stream
determineMimetypeFromExtension=false
X-DocPath=kioslave/curl/index.html
Class=:internet
